# Telegram Bot Configuration
TELEGRAM_TOKEN=telegram_bot_token_here

# OpenRouter API Configuration
OPENROUTER_KEY=your_openrouter_api_key_here
MODEL_NAME=deepseek/deepseek-v4-flash
BASE_URL=https://openrouter.ai/api/v1

# Database Configuration
DATABASE_PATH=date_user.db

# Optional: Set to false to disable database history
ENABLE_HISTORY=true

# Admin dashboard configuration
ADMIN_IDS=your_id_here
ACTIVE_USER_WINDOW_MINUTES=30

# User rate limit configuration
USER_HOURLY_LIMIT=10
RATE_LIMIT_WINDOW_HOURS=1

# AI context window configuration
CONTEXT_WINDOW_MESSAGES=10

# API retry configuration
API_MAX_RETRIES=2
API_RETRY_DELAY_SECONDS=2
API_TIMEOUT_SECONDS=60
